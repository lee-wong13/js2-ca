{
  "name": "js2-cs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tailwind:dev": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "tailwind:build": "tailwindcss -i ./css/input.css -o ./css/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": "prettier --write"
  }
}
